generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// Auth.js v5 required models
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model User {
  id            String     @id @default(cuid())
  name          String?
  email         String?    @unique
  emailVerified DateTime?
  image         String?
  createdAt     DateTime   @default(now())
  accounts      Account[]
  sessions      Session[]
  persons       Person[]
  logEntries    LogEntry[]
  threads       Thread[]
  tags          Tag[]
  mapViews      MapView[]
  plans         Plan[]
  suggestions   Suggestion[]
}

model Person {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name          String
  birthday      DateTime?
  // Fritt notat. Faste opplysninger («jobber i Statkraft») hører hjemme i Fact.
  notes         String?  @db.Text
  photoUrl      String?

  // Din relasjon til personen, og hvor ofte du vil minnes om å ta kontakt.
  // cadenceWeeks = null betyr eksplisitt «aldri auto-påminn».
  type          RelationshipType @default(FRIEND)
  cadenceWeeks  Int?             @default(4)
  snoozedUntil  DateTime?

  // Hovedtaggen gir personen farge nå, og gren i Kretser-kartet senere.
  primaryTagId  String?
  primaryTag    Tag?     @relation("PrimaryTag", fields: [primaryTagId], references: [id], onDelete: SetNull)

  positionX     Float    @default(0)
  positionY     Float    @default(0)
  createdAt     DateTime @default(now())

  tags           PersonTag[]
  facts          Fact[]
  participations LogParticipant[]
  threads        ThreadPerson[]
  phases         RomanticPhaseEntry[]
  plans          PlanPerson[]
  relationsFrom  Relationship[] @relation("FromPerson")
  relationsTo    Relationship[] @relation("ToPerson")
}

model Tag {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Lagres slik den først ble skrevet. Unik per bruker uten hensyn til store
  // og små bokstaver: håndhevet av indeksen «Tag_userId_lower_name_key» på
  // (userId, lower(name)), laget i v2_foundation-migreringen. Prisma kan
  // ikke uttrykke uttrykksindekser, så den står bare der — ikke fjern den.
  name      String
  // Palettnøkkel (src/lib/palette.ts), aldri hex.
  color     String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  persons   PersonTag[]
  primaryOf Person[] @relation("PrimaryTag")

  @@unique([userId, name])
}

model PersonTag {
  personId String
  tagId    String
  person   Person @relation(fields: [personId], references: [id], onDelete: Cascade)
  tag      Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([personId, tagId])
  @@index([tagId])
}

model Relationship {
  id           String           @id @default(cuid())
  fromPersonId String
  toPersonId   String
  fromPerson   Person           @relation("FromPerson", fields: [fromPersonId], references: [id], onDelete: Cascade)
  toPerson     Person           @relation("ToPerson", fields: [toPersonId], references: [id], onDelete: Cascade)
  type         RelationshipType
  // «klatrer sammen» — vises på kanten.
  label        String?
  since        DateTime?
  // Satt = historisk, f.eks. et avsluttet forhold.
  until        DateTime?
  createdAt    DateTime         @default(now())
}

enum RelationshipType {
  FRIEND
  FAMILY
  COLLEAGUE
  // Alt fra første date til kjæreste og eks. Fasen for dine egne ligger i
  // RomanticPhaseEntry; mellom andre er det since/until som forteller.
  ROMANTIC
  ACQUAINTANCE
  OTHER
}

model LogEntry {
  id        String        @id @default(cuid())
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      DateTime      @default(now())
  // Valgfri: fritekst er nok til å logge.
  type      LogEntryType?
  body      String?       @db.Text
  createdAt DateTime      @default(now())

  participants  LogParticipant[]
  threadsOpened Thread[] @relation("OpenedBy")
  threadsClosed Thread[] @relation("ClosedBy")
  plan          Plan?
  suggestions   Suggestion[]
  // Når Claude var ferdig med forslag til loggen (også når det ble ingen).
  suggestedAt   DateTime?

  @@index([userId, date])
}

enum LogEntryType {
  MET
  CALLED
  MESSAGE
  DATE
  OTHER
}

// En logg kan gjelde flere personer: «middag med Ingrid og Martin».
model LogParticipant {
  logEntryId String
  personId   String
  logEntry   LogEntry @relation(fields: [logEntryId], references: [id], onDelete: Cascade)
  person     Person   @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@id([logEntryId, personId])
  @@index([personId])
}

// Noe å følge opp: «andre intervjurunde i Statkraft». Erstatter de manuelle
// påminnelsene — en påminnelse med dato er en tråd med dueDate.
model Thread {
  id          String       @id @default(cuid())
  userId      String
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  status      ThreadStatus @default(OPEN)
  resolution  String?      @db.Text
  // Når den blir aktuell. null = aktuell nå.
  dueDate     DateTime?
  openedById  String?
  openedBy    LogEntry?    @relation("OpenedBy", fields: [openedById], references: [id], onDelete: SetNull)
  closedById  String?
  closedBy    LogEntry?    @relation("ClosedBy", fields: [closedById], references: [id], onDelete: SetNull)
  createdAt   DateTime     @default(now())
  closedAt    DateTime?
  persons     ThreadPerson[]

  @@index([userId, status])
}

enum ThreadStatus {
  OPEN
  CLOSED
}

model ThreadPerson {
  threadId String
  personId String
  thread   Thread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  person   Person @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@id([threadId, personId])
  @@index([personId])
}

// Faste opplysninger om en person: «Jobb» → «Statkraft (fra november)».
model Fact {
  id        String   @id @default(cuid())
  personId  String
  person    Person   @relation(fields: [personId], references: [id], onDelete: Cascade)
  label     String
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([personId])
}

enum RomanticPhase {
  FIRST_DATE
  SEEING
  EXCLUSIVE
  PARTNER
  ENDED
}

// Når du gikk fra én fase til neste med en du dater. Nyeste rad er
// gjeldende fase; ENDED betyr at det er over.
model RomanticPhaseEntry {
  id       String        @id @default(cuid())
  personId String
  person   Person        @relation(fields: [personId], references: [id], onDelete: Cascade)
  phase    RomanticPhase
  at       DateTime

  @@index([personId, at])
}

// En lagret visning av kartet: syn og filter under et navn, som «Vis til
// andre». Filteret er JSON (src/domain/mapFilter.ts) og normaliseres ved
// lesing, så en slettet tagg aldri ødelegger en visning.
model MapView {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  mode      String
  filter    Json
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@unique([userId, name])
}

// Noe som skal skje: «Middag med Ingrid lørdag». Blir til en logg når det
// har skjedd (logEntryId), eller avlyses. Loggen er det som faktisk skjedde;
// planen er det du hadde tenkt.
model Plan {
  id         String       @id @default(cuid())
  userId     String
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  at         DateTime
  // Uten klokkeslett lagres datoen kl. 12:00 UTC, som logger.
  hasTime    Boolean      @default(false)
  title      String
  type       LogEntryType?
  status     PlanStatus   @default(PLANNED)
  logEntryId String?      @unique
  logEntry   LogEntry?    @relation(fields: [logEntryId], references: [id], onDelete: SetNull)
  createdAt  DateTime     @default(now())
  persons    PlanPerson[]

  @@index([userId, status, at])
}

enum PlanStatus {
  PLANNED
  DONE
  CANCELLED
}

model PlanPerson {
  planId   String
  personId String
  plan     Plan   @relation(fields: [planId], references: [id], onDelete: Cascade)
  person   Person @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@id([planId, personId])
  @@index([personId])
}

// Forslag fra Claude til en logg: en tråd, et faktum, en deltaker eller en
// ny person. Godtas eller avvises med ett trykk. Innholdet (payload) er
// validert med zod per type når det leses.
model Suggestion {
  id         String           @id @default(cuid())
  userId     String
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  logEntryId String
  logEntry   LogEntry         @relation(fields: [logEntryId], references: [id], onDelete: Cascade)
  kind       SuggestionKind
  payload    Json
  status     SuggestionStatus @default(PENDING)
  createdAt  DateTime         @default(now())

  @@index([userId, status, createdAt])
  @@index([logEntryId])
}

enum SuggestionKind {
  THREAD
  FACT
  PARTICIPANT
  PERSON
}

enum SuggestionStatus {
  PENDING
  ACCEPTED
  DISMISSED
}
